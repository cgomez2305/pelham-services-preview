{"steps": [{"step": "runPHP", "code": "<?php\nrequire '/wordpress/wp-load.php';\nactivate_plugin('pelham-content/pelham-content.php');switch_theme('pelham-modern');\nupdate_option('home','http://127.0.0.1:9401');update_option('siteurl','http://127.0.0.1:9401');\npelham_import_content();\n$entries=json_decode(file_get_contents('/wordpress/wp-content/plugins/pelham-content/data/pages.json'),true);\nforeach($entries as $entry){$posts=get_posts(['post_type'=>$entry['type'],'name'=>basename($entry['route']),'numberposts'=>1]);if($posts)wp_update_post(['ID'=>$posts[0]->ID,'post_content'=>$entry['content']]);}\n$home=get_page_by_path('home');if($home){wp_update_post(['ID'=>$home->ID,'post_content'=>file_get_contents('/wordpress/wp-content/plugins/pelham-content/data/home.html')]);update_option('page_on_front',$home->ID);update_option('show_on_front','page');}\nupdate_option('blogname','Pelham Services');update_option('WPLANG','en_US');flush_rewrite_rules();\n"}]}